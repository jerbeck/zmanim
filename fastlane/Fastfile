default_platform(:ios)

platform :ios do
  # ── Shared build step ────────────────────────────────────────────────────────
  def build_watch_app(export_method:)
    build_app(
      project: "Zmanim.xcodeproj",
      scheme: "Zmanim Watch App",
      destination: "generic/platform=watchOS",
      export_method: export_method,
      output_directory: "build",
      output_name: "Zmanim",
      clean: true
    )
  end

  # ── beta: build and upload to TestFlight ─────────────────────────────────────
  desc "Build and upload to TestFlight"
  lane :beta do
    increment_build_number(xcodeproj: "Zmanim.xcodeproj")
    build_watch_app(export_method: "app-store")
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  # ── release: build and submit to the App Store ───────────────────────────────
  desc "Build and submit to the App Store"
  lane :release do
    increment_build_number(xcodeproj: "Zmanim.xcodeproj")
    build_watch_app(export_method: "app-store")
    upload_to_app_store(
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false   # set true to auto-submit after upload
    )
  end
end
